<Project Sdk="Microsoft.NET.Sdk">

  <!-- The executable: Kestrel on loopback, minimal API, embedded page. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClaudeCodeAccountRotation.App</RootNamespace>
    <AssemblyName>claude-code-account-rotation</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport's generated string marshalling for the exclusive-mkdir
         P/Invokes behind the refresh lock. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page ships inside the executable; no build step, no files beside it. -->
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClaudeCodeAccountRotation.Core/ClaudeCodeAccountRotation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory<Program> hosts the app in-process; the implicit
         top-level Program type stays internal. -->
    <InternalsVisibleTo Include="ClaudeCodeAccountRotation.App.Tests" />
  </ItemGroup>

</Project>
